      "conversation": [
        {
          "invocationId": "uptime-sla-t1",
          "userContent": {
            "parts": [
              {
                "text": "What's your uptime guarantee?"
              }
            ],
            "role": "user"
          },
          "finalResponse": {
            "parts": [
              {
                "text": "Our Business Fiber 1 Gbps and 5 Gbps plans include a 99.9% uptime SLA. For our Business Fiber 10 Gbps service, we offer a 99.95% uptime guarantee, which is the strongest in our portfolio.\n\nWe measure uptime per calendar month on the access circuit from our network to your demarcation point, excluding any pre-announced scheduled maintenance. If availability falls below those guaranteed levels, you can request a service credit. Once our support team confirms the outage, that credit is applied to your next invoice."
              }
            ],
            "role": "model"
          },
          "intermediateData": {
