# =============================================================================
# Conversational Sales Agent: shared environment (repo root)
#
#   cp .env.example .env      (scripts/setup_local.sh does this if .env is missing)
#
# Used by scripts/start_local.sh, scripts/db.sh and docker compose (env_file).
# Values already set in your shell take precedence over this file.
# NEVER commit .env. Cloud Run gets its values from Secret Manager instead
# (scripts/setup_gcp.sh + scripts/deploy_cloud.sh).
# =============================================================================

# --- LLM (required) ----------------------------------------------------------
GOOGLE_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview

# --- Database (required) -----------------------------------------------------
# Native processes (start_local.sh / db.sh): a PostgreSQL 16 database you run.
DATABASE_URL=postgresql://csa:csa@localhost:5432/csa
# docker compose: password of the bundled postgres container (compose overrides
# DATABASE_URL to postgresql://csa:${POSTGRES_PASSWORD}@postgres:5432/csa).
POSTGRES_PASSWORD=change-me-local-only
# docker compose: host interface for the published gateway port 8000 (0.0.0.0 = all interfaces)
GATEWAY_BIND=127.0.0.1
# Optional: explicit SQLAlchemy async URL for ADK sessions (derived from DATABASE_URL by default)
# SESSION_DB_URL=postgresql+asyncpg://csa:csa@localhost:5432/csa
# DB_POOL_MAX=5

# --- Gateway -----------------------------------------------------------------
# Signs chat session tokens. start_local.sh generates an ephemeral one if empty.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
# Gateway applies migrations on startup when true (scripts run them explicitly instead)
RUN_MIGRATIONS=false
SUGGESTIONS_ENABLED=true
RATE_LIMIT_RPM=20
RATE_LIMIT_RPH=200
RATE_LIMIT_BURST=5
SESSION_TOKEN_EXPIRY_MIN=60
# AGENT_URL_<A2A_NAME> are set by start_local.sh / docker compose / deploy_cloud.sh.
# Override only to point the gateway at agents running elsewhere, e.g.:
# AGENT_URL_DISCOVERY_AGENT=http://127.0.0.1:8201

# --- Service-to-service auth ---------------------------------------------------
# none (local / compose) | gcp_id_token (Cloud Run; set by deploy_cloud.sh)
SERVICE_AUTH=none

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false

# --- Gemini safety thresholds ------------------------------------------------
# BLOCK_NONE | BLOCK_LOW_AND_ABOVE | BLOCK_MEDIUM_AND_ABOVE | BLOCK_ONLY_HIGH
SAFETY_DANGEROUS=BLOCK_LOW_AND_ABOVE
SAFETY_HARASSMENT=BLOCK_LOW_AND_ABOVE
SAFETY_HATE_SPEECH=BLOCK_LOW_AND_ABOVE
SAFETY_SEXUALLY_EXPLICIT=BLOCK_LOW_AND_ABOVE

# --- Context compaction / caching (optional; defaults in sales_common.config) --
# COMPACTION_INTERVAL=8
# COMPACTION_OVERLAP=2
# COMPACTION_TOKEN_THRESHOLD=60000
# COMPACTION_RETENTION_EVENTS=10
# CONTEXT_CACHE_INTERVALS=10
# CONTEXT_CACHE_TTL_SECONDS=1800
# CONTEXT_CACHE_MIN_TOKENS=4096

# --- MCP client (agents -> tool services) --------------------------------------
# CATALOG_MCP_URL / SERVICEABILITY_MCP_URL are set by the scripts and compose.
# MCP_TIMEOUT_SECONDS=15

# --- Catalog service ---------------------------------------------------------
# CHROMA_PATH=services/catalog/data/embeddings
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_MODEL_PATH=
RAG_BUILD_ON_START=true

# --- Serviceability service --------------------------------------------------
# true: coverage from the coverage_zones table; false: upstream GIS API
USE_MOCK_DATA=true
# GIS_API_URL=
# GIS_API_KEY=

# --- Customer communication (email) ------------------------------------------
# false = simulated delivery (default). For Gmail use an App Password.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=ComSales Notifications
NOTIFY_POLL_SECONDS=10
