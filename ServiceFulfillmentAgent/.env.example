# service_fulfillment_agent (A2A service). Not loaded by code: containers get env
# from docker compose / Cloud Run. See the README "Agent Service Guide" (environment variables).
GEMINI_MODEL=gemini-3-flash-preview
GOOGLE_API_KEY=your_gemini_api_key_here
DATABASE_URL=postgresql://csa:<password>@127.0.0.1:5432/csa
PUBLIC_URL=http://localhost:8207
# SERVICE_AUTH=none
# LOG_LEVEL=INFO
