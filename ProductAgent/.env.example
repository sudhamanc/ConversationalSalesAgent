# Product agent (A2A service). Containers get env from compose / Cloud Run; no .env loading in code.
GEMINI_MODEL=gemini-3-flash-preview
GOOGLE_API_KEY=your_gemini_api_key_here
DATABASE_URL=postgresql://csa:<password>@127.0.0.1:5432/csa
PUBLIC_URL=http://localhost:8003
CATALOG_MCP_URL=http://localhost:8101/mcp/
SERVICE_AUTH=none
LOG_LEVEL=INFO
# Optional: MCP_TIMEOUT_SECONDS=15, MCP_TOOL_CACHE_SECONDS=300
