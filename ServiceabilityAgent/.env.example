# Serviceability Agent (A2A service). Containers get env from compose / Cloud Run;
# the agent does not load .env files.
GEMINI_MODEL="gemini-3-flash-preview"
GOOGLE_API_KEY="your-gemini-api-key-here"
DATABASE_URL="postgresql://csa:<password>@127.0.0.1:5432/csa"   # ADK sessions + A2A tasks
PUBLIC_URL="http://localhost:8002"
# MCP endpoint of services/serviceability (trailing slash required)
SERVICEABILITY_MCP_URL="http://localhost:8102/mcp/"
SERVICE_AUTH="none"          # gcp_id_token on Cloud Run
MCP_TIMEOUT_SECONDS="15"
LOG_LEVEL="INFO"
